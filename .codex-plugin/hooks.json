{
  "description": "Epic Harness lifecycle, safety, observation, formatting, and reflection hooks.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/registry/scripts/install.js\" hook SessionStart resume",
            "commandWindows": "node \"%PLUGIN_ROOT%\\registry\\scripts\\install.js\" hook SessionStart resume"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/registry/scripts/install.js\" hook PreToolUse guard",
            "commandWindows": "node \"%PLUGIN_ROOT%\\registry\\scripts\\install.js\" hook PreToolUse guard"
          }
        ]
      },
      {
        "matcher": "apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/registry/scripts/install.js\" hook PreToolUse guard",
            "commandWindows": "node \"%PLUGIN_ROOT%\\registry\\scripts\\install.js\" hook PreToolUse guard"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/registry/scripts/install.js\" hook PostToolUse observe",
            "commandWindows": "node \"%PLUGIN_ROOT%\\registry\\scripts\\install.js\" hook PostToolUse observe"
          }
        ]
      },
      {
        "matcher": "apply_patch|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/registry/scripts/install.js\" hook PostToolUse polish",
            "commandWindows": "node \"%PLUGIN_ROOT%\\registry\\scripts\\install.js\" hook PostToolUse polish"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/registry/scripts/install.js\" hook SubagentStart observe",
            "commandWindows": "node \"%PLUGIN_ROOT%\\registry\\scripts\\install.js\" hook SubagentStart observe"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/registry/scripts/install.js\" hook SubagentStop observe",
            "commandWindows": "node \"%PLUGIN_ROOT%\\registry\\scripts\\install.js\" hook SubagentStop observe"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/registry/scripts/install.js\" hook PreCompact snapshot",
            "commandWindows": "node \"%PLUGIN_ROOT%\\registry\\scripts\\install.js\" hook PreCompact snapshot"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/registry/scripts/install.js\" hook SessionEnd reflect",
            "commandWindows": "node \"%PLUGIN_ROOT%\\registry\\scripts\\install.js\" hook SessionEnd reflect",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
