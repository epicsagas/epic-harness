# codex-live-check environment. direnv auto-loads this after `direnv allow`;
# it is also a plain bash file, so `source .envrc` works without direnv.
# See README.md for the decisions behind each export.

export CODEX_LIVE_DIR="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)"

# Checkout whose .codex-plugin manifest gets seeded. Override to test a
# branch worktree: HARNESS_SRC=../epic-harness-pr118 ./setup.sh
export HARNESS_SRC="${HARNESS_SRC:-$CODEX_LIVE_DIR/../..}"

# Fully isolated codex home and harness data, OUTSIDE the repo: codex copies
# the whole plugin root (this checkout) on install, so any CODEX_HOME placed
# inside it recurses into itself ("File name too long"). The real ~/.codex is
# only read once (auth.json + appserver symlink in setup.sh); ~/.harness is
# never touched.
export CODEX_HOME="${HOME}/.cache/epic-codex-live/codex-home"
export HARNESS_DIR="${HOME}/.cache/epic-codex-live/harness"

# Deterministic epic binary: cargo bin wins over a Homebrew install.
export PATH="$HOME/.cargo/bin:$PATH"
