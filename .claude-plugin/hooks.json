{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/registry/scripts/install.js\"; epic resume",
            "async": false
          }
        ],
        "description": "Install binary if missing (cross-platform), seed skills/agents/commands/MCP, restore session context"
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "epic guard"
          }
        ],
        "description": "Block dangerous commands (force push, prod DB drop, rm -rf /)"
      },
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "epic observe"
          }
        ],
        "description": "Record agent spawn — the 'running' transition needs the pre-tool event; PostToolUse alone only ever sees a finished agent"
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "epic guard"
          }
        ],
        "description": "Orchestration pause directives and concurrent write conflict warnings"
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "epic polish"
          }
        ],
        "description": "Auto-format + typecheck + lint warning after edits"
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "epic observe",
            "async": true,
            "timeout": 5
          }
        ],
        "description": "Record tool result for evolution loop"
      }
    ],
    "PreCompact": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "epic snapshot"
          }
        ],
        "description": "Save working state before context compaction"
      }
    ],
    "SessionEnd": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "epic reflect"
          }
        ],
        "description": "Analyze session observations → evolve skills → gate mutations"
      }
    ]
  }
}
