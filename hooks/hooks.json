{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/setup.sh\"",
            "async": true
          },
          {
            "type": "command",
            "command": "EH=\"${CLAUDE_PLUGIN_ROOT}/hooks/bin/epic-harness\"; test -x \"$EH\" || EH=$(command -v epic-harness 2>/dev/null); test -n \"$EH\" && \"$EH\" resume"
          }
        ],
        "description": "Auto-install binary if missing, then restore previous session context + load project memory and evolved skills"
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "EH=\"${CLAUDE_PLUGIN_ROOT}/hooks/bin/epic-harness\"; test -x \"$EH\" || EH=$(command -v epic-harness 2>/dev/null); test -n \"$EH\" && \"$EH\" guard"
          }
        ],
        "description": "Block dangerous commands (force push, prod DB drop, rm -rf /)"
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "EH=\"${CLAUDE_PLUGIN_ROOT}/hooks/bin/epic-harness\"; test -x \"$EH\" || EH=$(command -v epic-harness 2>/dev/null); test -n \"$EH\" && \"$EH\" polish"
          }
        ],
        "description": "Auto-format + typecheck + lint warning after edits"
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "EH=\"${CLAUDE_PLUGIN_ROOT}/hooks/bin/epic-harness\"; test -x \"$EH\" || EH=$(command -v epic-harness 2>/dev/null); test -n \"$EH\" && \"$EH\" observe",
            "async": true,
            "timeout": 5
          }
        ],
        "description": "Record tool result for evolution loop"
      }
    ],
    "PreCompact": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "EH=\"${CLAUDE_PLUGIN_ROOT}/hooks/bin/epic-harness\"; test -x \"$EH\" || EH=$(command -v epic-harness 2>/dev/null); test -n \"$EH\" && \"$EH\" snapshot"
          }
        ],
        "description": "Save working state before context compaction"
      }
    ],
    "SessionEnd": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "EH=\"${CLAUDE_PLUGIN_ROOT}/hooks/bin/epic-harness\"; test -x \"$EH\" || EH=$(command -v epic-harness 2>/dev/null); test -n \"$EH\" && \"$EH\" reflect"
          }
        ],
        "description": "Analyze session observations → evolve skills → gate mutations"
      }
    ]
  }
}
