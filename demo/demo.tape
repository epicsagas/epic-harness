Output demo/demo.gif
Set FontSize 14
Set Width 900
Set Height 550
Set Theme "Dracula"
Set Padding 20
Set TypingSpeed 40ms
Set PlaybackSpeed 1

# ── intro ──
Sleep 500ms
Type "# epic-harness — self-evolving AI coding agent harness"
Sleep 800ms
Enter
Sleep 400ms

# ── install verification ──
Type "epic version"
Sleep 300ms
Enter
Sleep 1s

# ── help overview ──
Type "epic help"
Sleep 300ms
Enter
Sleep 1.5s

# ── telemetry ──
Type "epic telemetry status"
Sleep 300ms
Enter
Sleep 1s

# ── guard demo ──
Sleep 400ms
Type "# Guard rails — dangerous commands are blocked before execution"
Sleep 600ms
Enter
Sleep 300ms

# ── mem quick demo ──
Type "epic mem add --title 'Use cursor-based pagination' --type decision --project demo"
Sleep 300ms
Enter
Sleep 1.2s

Type "epic mem search 'pagination'"
Sleep 300ms
Enter
Sleep 1s

# ── outro ──
Sleep 500ms
Type "# Install:  cargo install epic-harness && epic install"
Sleep 600ms
Enter
Sleep 300ms
Type "# Docs:     github.com/epicsagas/epic-harness"
Sleep 600ms
Enter
Sleep 1.5s
