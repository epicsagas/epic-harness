{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node ${GROK_PLUGIN_ROOT}/registry/scripts/hooks/run.mjs resume",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node ${GROK_PLUGIN_ROOT}/registry/scripts/hooks/run.mjs guard",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node ${GROK_PLUGIN_ROOT}/registry/scripts/hooks/run.mjs polish",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node ${GROK_PLUGIN_ROOT}/registry/scripts/hooks/run.mjs observe",
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node ${GROK_PLUGIN_ROOT}/registry/scripts/hooks/run.mjs observe",
            "timeout": 5
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node ${GROK_PLUGIN_ROOT}/registry/scripts/hooks/run.mjs snapshot",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node ${GROK_PLUGIN_ROOT}/registry/scripts/hooks/run.mjs reflect",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
