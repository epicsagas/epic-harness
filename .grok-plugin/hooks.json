{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "epic resume",
            "timeout": 10
          }
        ],
        "description": "Restore session context and load memory"
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "epic guard",
            "timeout": 5
          }
        ],
        "description": "Block dangerous commands (force push, prod DB drop, rm -rf /)"
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "epic polish",
            "timeout": 30
          }
        ],
        "description": "Auto-format + typecheck + lint warning after edits"
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "epic observe",
            "timeout": 5
          }
        ],
        "description": "Record tool result for evolution loop"
      }
    ],
    "SubagentStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "epic observe",
            "timeout": 5
          }
        ],
        "description": "Mark subagent running — PostToolUse alone only ever sees completion"
      }
    ],
    "PreCompact": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "epic snapshot",
            "timeout": 10
          }
        ],
        "description": "Save working state before context compaction"
      }
    ],
    "SessionEnd": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "epic reflect",
            "timeout": 30
          }
        ],
        "description": "Analyze session observations, evolve skills, gate mutations"
      }
    ]
  }
}
